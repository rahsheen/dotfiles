#!/usr/bin/env bash
#
# push-secrets — install Atlassian and Claude credentials into a Coder
# workspace.
#
# This repo is public, so tokens can never ship in install.sh. Most of what the
# workspace needs is already provisioned by the acme template (GitHub Packages
# via ~/.npmrc, contribsys via ~/.bundle/config, gh auth). Two gaps are not:
# Atlassian, which blocks the jira CLI plus the pr-jira-status and
# ticket-readiness skills that shell out to `jira issue`; and Claude, since the
# template carries no Anthropic or Bedrock key, so `claude` runs its login
# wizard on a fresh box.
#
# Credentials are piped over stdin rather than passed as arguments, so they
# never appear in an argv (visible in `ps`) or in shell history on either host.
#
# Usage: push-secrets <workspace-name>
# Example: push-secrets PT-1610-qa-review

set -euo pipefail

WORKSPACE="${1:-}"
if [ -z "${WORKSPACE}" ]; then
  echo "Usage: push-secrets <workspace-name>" >&2
  echo "Example: push-secrets PT-1610-qa-review" >&2
  exit 1
fi

# Relies on the `coder.*` hosts written by `coder config-ssh`.
CODER_HOST="coder.${WORKSPACE}"

JIRA_CONFIG="$HOME/.config/.jira/.config.yml"

# cme resolves its config dir with typer's get_app_dir: "Application Support"
# on macOS, XDG on Linux.
if [ -d "$HOME/Library/Application Support/confluence-markdown-exporter" ]; then
  CME_APP_DATA="$HOME/Library/Application Support/confluence-markdown-exporter/app_data.json"
else
  CME_APP_DATA="${XDG_CONFIG_HOME:-$HOME/.config}/confluence-markdown-exporter/app_data.json"
fi

command -v jq > /dev/null 2>&1 || { echo "Error: jq is required." >&2; exit 1; }

# --- Collect credentials ---------------------------------------------------

# Both tokens live in ~/.zshenv, which a non-interactive caller may not have
# sourced. Last assignment wins, matching how the shell would read it.
read_from_zshenv() {
  [ -f "$HOME/.zshenv" ] || return 0
  sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}$1=//p" \
    "$HOME/.zshenv" | tail -1 | tr -d "\"'"
}

if [ -z "${JIRA_API_TOKEN:-}" ]; then
  JIRA_API_TOKEN="$(read_from_zshenv JIRA_API_TOKEN)"
fi

if [ -z "${JIRA_API_TOKEN:-}" ]; then
  echo "Error: JIRA_API_TOKEN is not set and could not be read from ~/.zshenv." >&2
  exit 1
fi

if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  CLAUDE_CODE_OAUTH_TOKEN="$(read_from_zshenv CLAUDE_CODE_OAUTH_TOKEN)"
fi

# Non-fatal: qa-coder calls this too, and a QA review does not need Claude.
if [ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
  echo "Warning: CLAUDE_CODE_OAUTH_TOKEN not set; claude will run its login wizard." >&2
fi

# Carry cme's whole auth object — it holds both a confluence and a jira block,
# each keyed by site URL, and env vars outrank the JSON file in cme's settings
# precedence. So one variable replaces the config file entirely on the remote.
CME_AUTH=""
if [ -f "$CME_APP_DATA" ]; then
  CME_AUTH="$(jq -c '.auth // empty' "$CME_APP_DATA")"
fi

if [ -z "${CME_AUTH}" ]; then
  echo "Warning: no cme auth at ${CME_APP_DATA}; Confluence export will not work." >&2
fi

# --- Push ------------------------------------------------------------------

echo "--- 🔐 Pushing credentials to ${WORKSPACE} ---"

# printf %q quotes for re-sourcing; zsh understands bash's $'...' form.
{
  echo "# Written by push-secrets. Machine-local, never committed."
  printf 'export JIRA_API_TOKEN=%q\n' "${JIRA_API_TOKEN}"
  if [ -n "${CME_AUTH}" ]; then
    printf 'export CME_AUTH=%q\n' "${CME_AUTH}"
  fi
  if [ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]; then
    printf 'export CLAUDE_CODE_OAUTH_TOKEN=%q\n' "${CLAUDE_CODE_OAUTH_TOKEN}"
  fi
} | ssh "${CODER_HOST}" 'umask 077; cat > "$HOME/.zshenv.local"' || {
  echo "Error: failed to write ~/.zshenv.local on ${WORKSPACE}." >&2
  exit 1
}
echo "  -> ~/.zshenv.local (0600)"

# jira-cli is useless without this file: it carries server, login, project,
# board id and every custom-field schema. No credential in it, so an ordinary
# transfer is fine. Regenerating it means an interactive `jira init`.
if [ -f "${JIRA_CONFIG}" ]; then
  ssh "${CODER_HOST}" 'mkdir -p "$HOME/.config/.jira"'
  scp -q "${JIRA_CONFIG}" "${CODER_HOST}:.config/.jira/.config.yml"
  echo "  -> ~/.config/.jira/.config.yml"
else
  echo "Warning: ${JIRA_CONFIG} not found; run 'jira init' locally first." >&2
fi

# --- Verify ----------------------------------------------------------------

# The check runs a NON-interactive zsh on purpose. Claude Code's Bash tool does
# not use an interactive shell, so a token that only shows up under `zsh -i` is
# invisible to every `jira` call Claude makes. `zsh -s` reads stdin and still
# sources .zshenv, which is exactly the path that has to work.
printf '%s\n' '
if [ -n "$JIRA_API_TOKEN" ]; then
  echo "  ok: JIRA_API_TOKEN visible to non-interactive zsh"
else
  echo "  WARN: not visible — is the install.sh env shim present in ~/.zshenv?"
fi
if [ -n "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
  echo "  ok: CLAUDE_CODE_OAUTH_TOKEN visible to non-interactive zsh"
else
  echo "  note: no CLAUDE_CODE_OAUTH_TOKEN — claude will prompt for login"
fi
if command -v jira > /dev/null 2>&1; then
  echo "  ok: jira CLI on PATH"
else
  echo "  note: jira CLI not installed in this workspace yet"
fi' | ssh "${CODER_HOST}" 'zsh -s'

echo "--- ✅ Secrets pushed ---"
