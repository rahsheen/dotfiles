.cfg
undodir

# ~/.claude is mostly runtime state (history.jsonl, sessions/, projects/, caches)
# and this repo is PUBLIC. Allowlist rather than denylist: the state dirs grow
# over time and enumerating them is a losing game.
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/RTK.md
!.claude/statusline-command.sh
!.claude/hooks/

# Skills are either skillsync symlinks (regenerated from
# ~/.config/agent-skills/sources.json) or our own. Re-include the directory so
# git will descend, exclude its contents, then re-include the ones we author.
!.claude/skills/
.claude/skills/*
!.claude/skills/e2e-playwright/
!.claude/skills/ticket-readiness/
!.claude/skills/pr-jira-status/

# bragdoc is deliberately NOT tracked: references/rr-rubric.md is a verbatim
# export of an internal competency matrix and this repo is public.

**/__pycache__/

# Credential denylist. The work tree is $HOME and this repo is PUBLIC, so every
# secret on this machine already sits inside it — untracked, but one `git add -A`
# from being published. status.showUntrackedFiles=no means they never show up in
# `git status` either, so there is no second chance to notice. Deny explicitly.
#
# Anything here that a Coder workspace needs is delivered by `push-secrets`
# (~/.zshenv.local, ~/.config/.jira/.config.yml) or by the acme template
# (~/.aws/.env.coder, ~/.npmrc, ~/.bundle/config) — never by this repo.
.zshenv
.zshenv.local
.zprofile
.netrc
.npmrc
.ssh/
.aws/
.gnupg/
.bundle/config
.config/gh/hosts.yml
.config/op/
.config/.jira/
.config/confluence-markdown-exporter/
.local/share/confluence-markdown-exporter/

# macOS application state, including the confluence-markdown-exporter auth store
# and the decoy `coder dotfiles` clone of this very repo.
Library/
