{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash",
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(rtk grep *)",
      "Bash(rtk read *)",
      "Bash(rtk rspec *)",
      "Bash(rtk git *)",
      "Bash(git checkout *)",
      "Bash(jira issue *)",
      "Bash(rtk playwright *)",
      "Bash(rtk ls *)",
      "Bash(node *)",
      "Bash(npx eslint *)",
      "Bash(rtk eslint *)",
      "Bash(npx vitest *)",
      "Bash(rtk vitest *)",
      "Bash(cd * && npx vitest *)",
      "Bash(bundle exec rubocop *)",
      "Bash(rtk rubocop *)",
      "Bash(RAILS_ENV=test bundle exec rspec *)",
      "Bash(find *)",
      "Bash(wc -l *)",
      "Edit(~/.claude/skills/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/rtk-hook.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "promptSuggestionEnabled": false,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}
