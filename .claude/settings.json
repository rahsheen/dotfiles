{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(gh pr *)",
      "Bash(gh api *)",
      "Bash(rtk grep *)",
      "Bash(rtk read *)",
      "Bash(rtk rspec *)",
      "Bash(rtk git *)",
      "Bash(git checkout *)",
      "Bash(jira issue *)",
      "Bash(rtk playwright *)",
      "Bash(rtk ls *)",
      "Bash(npx eslint *)",
      "Bash(rtk eslint *)",
      "Bash(npx vitest *)",
      "Bash(rtk vitest *)",
      "Bash(cd * && npx vitest *)",
      "Bash(bundle exec rubocop *)",
      "Bash(rtk rubocop *)",
      "Bash(RAILS_ENV=test bundle exec rspec *)",
      "Bash(find *)",
      "Bash(wc -l *)",
      "Bash(coder delete *)",
      "Edit(~/.claude/skills/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f ~/.claude/hooks/herdr-agent-state.sh ] && bash ~/.claude/hooks/herdr-agent-state.sh session || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/coder-deadline.sh hook",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/coder-deadline.sh hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@roadrunner-agent-skills": true,
    "ruby-lsp@roadrunner-agent-skills": true,
    "roadrunner-workflow-skills@roadrunner-agent-skills": true,
    "approved-example-skills@roadrunner-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "roadrunner-agent-skills": {
      "source": {
        "source": "github",
        "repo": "RoadRunnerEngineering/rr-skills"
      }
    }
  },
  "subagentPromptCacheTtl": "1h",
  "promptSuggestionEnabled": false,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "autoMemoryEnabled": false
}
