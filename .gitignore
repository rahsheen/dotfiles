.cfg
undodir

# ~/.claude is mostly runtime state (history.jsonl, sessions/, projects/, caches)
# and this repo is PUBLIC. Allowlist rather than denylist: the state dirs grow
# over time and enumerating them is a losing game.
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/RTK.md
!.claude/statusline-command.sh
!.claude/hooks/

# Skills are either skillsync symlinks (regenerated from
# ~/.config/agent-skills/sources.json) or our own, whose home is still undecided.
# Re-include the directory so git will descend, then exclude its contents.
!.claude/skills/
.claude/skills/*

**/__pycache__/
