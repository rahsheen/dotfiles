#!/usr/bin/env bash
# Restore declared skills. --check verifies; --dry-run prints the plan.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Avoid an asdf Python shim without a selected Python version.
if [ -x /usr/bin/python3 ]; then
  exec /usr/bin/python3 "$SCRIPT_DIR/skills-manager.py" "$@"
fi
exec python3 "$SCRIPT_DIR/skills-manager.py" "$@"
