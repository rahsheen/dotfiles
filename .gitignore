.cfg
undodir

# ~/.claude is mostly runtime state (history.jsonl, sessions/, projects/, caches)
# and this repo is PUBLIC. Allowlist rather than denylist: the state dirs grow
# over time and enumerating them is a losing game.
.claude/*
!.claude/settings.json
!.claude/CLAUDE.md
!.claude/RTK.md
!.claude/statusline-command.sh
!.claude/hooks/

# Skills are either skillsync symlinks (regenerated from
# ~/.config/agent-skills/sources.json) or our own. Re-include the directory so
# git will descend, exclude its contents, then re-include the ones we author.
!.claude/skills/
.claude/skills/*
!.claude/skills/e2e-playwright/
!.claude/skills/ticket-readiness/
!.claude/skills/pr-jira-status/

# bragdoc is deliberately NOT tracked: references/rr-rubric.md is a verbatim
# export of an internal competency matrix and this repo is public.

**/__pycache__/
